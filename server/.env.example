PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/wdm
MONGO_DB_NAME=wdm
JWT_SECRET=replace-with-a-secure-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# SMTP Configuration for Email Verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_ORDER_TEMPLATE_NAME=jaspers_market_order_confirmation_v1
WHATSAPP_ORDER_TEMPLATE_LANGUAGE=en_US
WHATSAPP_DELIVERY_TEMPLATE_NAME=thank_you_for_ordering
WHATSAPP_DELIVERY_TEMPLATE_LANGUAGE=en
